# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Origin allowed to send credentialed requests (the deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Set to "production" on a deployed host so auth cookies use Secure + SameSite=None
NODE_ENV=development
